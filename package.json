{
  "name": "facturador-arca",
  "version": "0.1.1",
  "description": "Emití Factura C en ARCA (ex-AFIP) desde la terminal: CAE + PDF con QR, sin intermediarios. Para monotributistas.",
  "keywords": [
    "arca",
    "afip",
    "factura",
    "factura-electronica",
    "monotributo",
    "wsfe",
    "wsaa",
    "cae",
    "argentina",
    "cli"
  ],
  "license": "MIT",
  "author": "Juan Martin Gimenez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ann0nip/facturador-arca-cli.git"
  },
  "homepage": "https://github.com/ann0nip/facturador-arca-cli#readme",
  "bugs": "https://github.com/ann0nip/facturador-arca-cli/issues",
  "type": "module",
  "bin": {
    "facturar": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
